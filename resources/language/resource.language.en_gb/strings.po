msgid "General"
msgstr ""

msgctxt "#30001"
msgid "Download catalogues"
msgstr ""

msgctxt "#30002"
msgid "Download libretro catalogues from GitHub when missing or stale"
msgstr ""

msgctxt "#30003"
msgid "Refresh catalogues after (days)"
msgstr ""

msgctxt "#30004"
msgid "A downloaded catalogue older than this is fetched again the next time it is needed"
msgstr ""

msgctxt "#30005"
msgid "Provider order"
msgstr ""

msgctxt "#30006"
msgid "Comma-separated list of catalogues asked in this order: libretro, retroachievements, screenscraper, igdb, thegamesdb. The first that recognises a file wins and the others fill in what it lacks. A catalogue left out of the list is not used; the online ones also need their keys entered in their own category."
msgstr ""

